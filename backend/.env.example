# ==============================================================================
# MahaResilience Backend Configuration Template
# Copy this file to .env and fill in your authorized credentials.
# ==============================================================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Prisma Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/maharesilience?schema=public

# Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@domain.com
BREVO_SENDER_NAME=MahaResilience Civic Portal

# Razorpay UPI / Payment Gateway Configuration
# In development/test mode, omit or use mock credentials to run with the built-in Sandbox Simulator.
PAYMENT_PROVIDER=RAZORPAY
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Telecom Prepaid Recharge Provider Configuration
# Supported: Jio, Airtel, Vi, BSNL. Built-in telecom catalog runs seamlessly in sandbox.
TELECOM_PROVIDER=STANDARD_TELECOM
TELECOM_API_KEY=your_telecom_api_key
TELECOM_API_SECRET=your_telecom_api_secret

# Optional Services
GOOGLE_GENAI_API_KEY=your_gemini_api_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_UPLOAD_PRESET=your_preset
GEOAPIFY_API_KEY=your_geoapify_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

